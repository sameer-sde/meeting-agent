# Copy this file to .env for running the web app on your own computer.
# Never commit .env. Online, set these in Render's Environment tab instead.

# A long random string. Protects sign-in cookies and encrypts users' Vexa keys.
# Don't change it after people have signed up, or their saved keys stop working.
SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave unset locally (uses local.db). Online: your Neon connection string.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Your app's public address, used for links in emails. Example: https://meeting-agent.onrender.com
# PUBLIC_URL=

# Google sign-in (Google Cloud Console -> Credentials -> OAuth client ID -> Web application)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Report writer. With GEMINI_API_KEY set, Gemini writes reports; otherwise Ollama on this computer.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Telegram "are you joining?" check-in (one bot for the whole app)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=sameer_meeting_agent_bot

# Email (Brevo free SMTP: smtp-relay.brevo.com, port 587; or Gmail: smtp.gmail.com, port 465)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Meeting Agent <reports@yourdomain.com>

# Secret for the every-minute background check (/cron/tick?key=...)
# CRON_SECRET=

DISPLAY_TZ=Asia/Kolkata
